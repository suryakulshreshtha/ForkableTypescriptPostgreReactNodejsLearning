# Copy this file to .env and adjust as needed.

PORT=4000

# Dev database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=forkable_learning

# Used by tests/setup — points at an isolated database so tests never
# touch dev data. When using docker-compose, this is exposed on 5433.
TEST_PGHOST=localhost
TEST_PGPORT=5432
TEST_PGUSER=postgres
TEST_PGPASSWORD=postgres
TEST_PGDATABASE=forkable_learning_test
