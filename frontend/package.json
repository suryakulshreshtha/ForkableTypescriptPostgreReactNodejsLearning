{
  "name": "forkable-learning-frontend",
  "version": "1.0.0",
  "description": "React + TypeScript frontend for a mindful-practice learning app (meditation library, session streaks, retreats, testimonials)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
